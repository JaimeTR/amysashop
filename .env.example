# Copia este archivo a .env.local (local) o configura estas variables en tu hosting.
# IMPORTANTE: las variables NEXT_PUBLIC_* se incluyen en el JavaScript del navegador.
# Nunca pongas claves secretas en una variable NEXT_PUBLIC_*.

# Supabase principal (tienda)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Supabase módulo digital
NEXT_PUBLIC_DIGITAL_SUPABASE_URL=
NEXT_PUBLIC_DIGITAL_SUPABASE_ANON_KEY=
DIGITAL_SUPABASE_SECRET_KEY=

# Admin
ADMIN_ALLOWED_EMAIL=
NEXT_PUBLIC_ADMIN_ALLOWED_EMAIL=

# Dominio (enlaces de correos y redirecciones)
NEXT_PUBLIC_SITE_URL=https://amysashop.com

# WhatsApp / contacto
NEXT_PUBLIC_WHATSAPP_PHONE=51965312386
NEXT_PUBLIC_WHATSAPP_DISPLAY_PHONE=965 312 386

# Redes sociales
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Buckets
NEXT_PUBLIC_SUPABASE_PROFILE_AVATARS_BUCKET=profile-avatars
NEXT_PUBLIC_SUPABASE_PRODUCTS_BUCKET=products

# Pagos (checkout)
NEXT_PUBLIC_YAPE_QR_URL=
NEXT_PUBLIC_PLIN_QR_URL=
NEXT_PUBLIC_BANK_BCP_ACCOUNT=
NEXT_PUBLIC_BANK_BCP_CCI=
NEXT_PUBLIC_BANK_BBVA_ACCOUNT=
NEXT_PUBLIC_BANK_BBVA_CCI=
NEXT_PUBLIC_BANK_INTERBANK_ACCOUNT=
NEXT_PUBLIC_BANK_INTERBANK_CCI=

# Asistente de chat (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# Correos (Resend para módulo digital; SMTP para formulario de contacto)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
